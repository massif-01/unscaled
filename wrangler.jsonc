{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unscaled",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "unscaled.me/*", "zone_name": "unscaled.me" },
    { "pattern": "admin.unscaled.me", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unscaled",
      "database_id": "f0966a59-7003-40f0-a8b2-3e862a7bbb37",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["15 0 * * *"]
  }
}
